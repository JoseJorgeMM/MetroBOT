# Configuración pública opcional de CARTO.
VITE_CARTO_API_KEY=

# Privada: interpreta necesidades de viaje; nunca VITE_ ni incluida en el cliente.
GEMINI_API_KEY=
# Modelo configurable; el servidor usa gemini-2.5-flash por defecto.
GEMINI_MODEL=gemini-2.5-flash

# Privada: Vercel Secret/Sensitive; solo servidor, únicamente Routes API.
# Nunca añadir prefijo VITE_ ni incluir en el cliente.
GOOGLE_ROUTES_API_KEY=

# Pública: Vercel Config; restringir por HTTP referrers y solo Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=

# Interruptor opcional del servidor; true por defecto si se omite.
# Descomentar para desactivar las consultas de transporte a Google.
# GOOGLE_TRANSIT_ENABLED=false
